#!/bin/bash -e

ROOT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"

if [ ! -f "$ROOT_DIR/config.sh" ]; then
	echo "Missing $ROOT_DIR/config.sh; copy config.sh-sample and configure CHROMIUM_PROFILE_PATH" >&2
	exit 1
fi

. "$ROOT_DIR/config.sh"

if [ -z "$CHROMIUM_PROFILE_PATH" ]; then
	echo "CHROMIUM_PROFILE_PATH is not set in $ROOT_DIR/config.sh" >&2
	exit 1
fi

if [ -z "$BUILD_DIR" ]; then
	BUILD_DIR="$ROOT_DIR/build"
fi

PERSISTENT=
if [ "$1" = "--persistent" ]; then
	PERSISTENT=1
	shift
fi

DEVTOOLS_ACTIVE_PORT="$CHROMIUM_PROFILE_PATH/DevToolsActivePort"
EXTENSION_PATH="${1:-$BUILD_DIR/manifestv3}"

if [ ! -f "$DEVTOOLS_ACTIVE_PORT" ]; then
	echo "Cannot connect to Chromium: $DEVTOOLS_ACTIVE_PORT does not exist." >&2
	echo "Enable remote debugging at chrome://inspect/#remote-debugging (or the browser-specific equivalent)." >&2
	exit 1
fi

if [ ! -f "$EXTENSION_PATH/manifest.json" ]; then
	echo "Cannot load extension: $EXTENSION_PATH/manifest.json does not exist" >&2
	exit 1
fi

cd "$ROOT_DIR"
exec node scripts/reload-chromium-extension.js "$DEVTOOLS_ACTIVE_PORT" "$EXTENSION_PATH" "$PERSISTENT"
